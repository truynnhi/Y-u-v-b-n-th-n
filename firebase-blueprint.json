{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "The player's profile and character information.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "The user's unique ID." },
        "displayName": { "type": "string", "description": "The user's display name." },
        "email": { "type": "string", "format": "email", "description": "The user's email address." },
        "character": {
          "type": "object",
          "properties": {
            "name": { "type": "string" },
            "age": { "type": "number" },
            "quirk": { "type": "string" },
            "background": { "type": "string" },
            "occupation": { "type": "string" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "createdAt", "updatedAt"]
    },
    "ChatMessage": {
      "title": "ChatMessage",
      "description": "A message in the roleplay simulation.",
      "type": "object",
      "properties": {
        "role": { "type": "string", "enum": ["user", "model", "system"] },
        "content": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["role", "content", "timestamp"]
    },
    "NPC": {
      "title": "NPC",
      "description": "A generated Non-Player Character in the world.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "age": { "type": "number" },
        "nationality": { "type": "string" },
        "occupation": { "type": "string" },
        "background": { "type": "string" },
        "personality": { "type": "string" },
        "quirk": { "type": "string" },
        "relationships": { "type": "string" },
        "currentSituation": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "createdAt", "updatedAt"]
    },
    "WorldEvent": {
      "title": "WorldEvent",
      "description": "An ongoing event in the simulation.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "scale": { "type": "string", "enum": ["minor", "medium", "major"] },
        "status": { "type": "string", "enum": ["active", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "scale", "status", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Stores user profiles and their character data."
    },
    "/users/{userId}/messages/{messageId}": {
      "schema": { "$ref": "#/entities/ChatMessage" },
      "description": "Stores the chat history for the user's simulation."
    },
    "/users/{userId}/npcs/{npcId}": {
      "schema": { "$ref": "#/entities/NPC" },
      "description": "Stores the NPCs generated for the user's world."
    },
    "/users/{userId}/events/{eventId}": {
      "schema": { "$ref": "#/entities/WorldEvent" },
      "description": "Stores the world events generated for the user's world."
    }
  }
}
